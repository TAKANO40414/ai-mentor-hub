# Anthropic Claude APIキー（AI要約機能に必要）
# https://console.anthropic.com/ で取得してください
ANTHROPIC_API_KEY=

# 省略可（デフォルト: claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# ローカルOllamaを使う場合（省略可、デフォルト: http://localhost:11434）
# Ollamaを起動しておけば、インストール済みモデルがAIチャットの選択肢に自動で表示されます
OLLAMA_BASE_URL=http://localhost:11434
